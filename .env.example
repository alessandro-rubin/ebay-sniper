# Copy to .env and fill in. Never commit .env.

# eBay developer keyset (Production for real use), https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production (default) or sandbox: the environment of the keyset above.
# The sandbox has test listings only: check-config --live and search work,
# run-once and watch refuse to start.
EBAY_ENVIRONMENT=production

# Telegram bot from @BotFather, and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
